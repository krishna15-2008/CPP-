#include <iostream>
using namespace std;

class Vehicle
{
public:
    void vehicle()
    {
        cout << "This is a vehicle" << endl;
    }
};

class Car : public Vehicle
{
public:
    void car()
    {
        cout << "This is a car" << endl;
    }
};

int main()
{
    Car obj;

    obj.vehicle();
    obj.car();

    return 0;
}